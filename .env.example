# EduAI — environment configuration
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored and
# must stay that way: it holds live credentials.
#
#     cp .env.example .env
#
# A real environment variable always beats the file, so a deployment can set
# these directly instead.


# ── Development ──────────────────────────────────────────────────────────
# Leave all three unset and the project runs locally with no configuration:
# DEBUG on, a published fallback key, and localhost in ALLOWED_HOSTS.


# ── Production ───────────────────────────────────────────────────────────
# Setting DJANGO_DEBUG=0 makes the other two mandatory — the project refuses
# to start without them rather than falling back to development values.

# DJANGO_DEBUG=0

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# DJANGO_SECRET_KEY=

# Comma-separated hostnames this site is served from.
# DJANGO_ALLOWED_HOSTS=eduai.example.com,www.eduai.example.com

# Set to 1 when a reverse proxy terminates TLS and forwards X-Forwarded-Proto.
# DJANGO_BEHIND_TLS_PROXY=0


# ── SSLCommerz payment gateway ───────────────────────────────────────────
# From the SSLCommerz merchant panel. Sandbox and live stores have separate
# credentials — leave SSLCOMMERZ_SANDBOX on until you have tested with real
# cards on the live store.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=1

# The base URL SSLCommerz redirects the customer back to. Must be reachable
# from the public internet for the payment notification to arrive.
# SSLCOMMERZ_BASE_URL=http://127.0.0.1:8000


# ── Manual payment flow ──────────────────────────────────────────────────
# The mobile-banking number students send manual payments to.
# PAYMENT_RECIPIENT_NUMBER=01700000000
